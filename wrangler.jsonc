{
  "name": "hcdle",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "HCDLE_KV", "id": "PEGAR_ACA_EL_ID_DEL_KV" }
  ],
  "observability": { "enabled": true }
}
